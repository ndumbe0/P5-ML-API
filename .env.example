# =============================================================================
# P5-ML-API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# API key for authenticating requests to /predict, /predict-batch, /model-info
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-secure-random-key

# Google AI Studio key for Gemini explanations (optional)
# Get one at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
